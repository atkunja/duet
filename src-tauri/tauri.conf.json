{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duet",
  "version": "0.1.0",
  "identifier": "dev.duet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Duet",
      "width": 1320,
      "height": 840,
      "minWidth": 980,
      "minHeight": 680,
      "decorations": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "transparent": false,
      "backgroundColor": "#0c0d10"
    }],
    "security": { "csp": "default-src 'self'; style-src 'self'; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost; frame-src http://localhost:* http://127.0.0.1:*" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Claude builds. Codex thinks. Duet proves.",
    "longDescription": "A local-first native orchestrator for Claude Code and OpenAI Codex CLI.",
    "copyright": "Copyright © 2026 Duet Contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-", "hardenedRuntime": true, "dmg": { "windowSize": { "width": 660, "height": 400 }, "appPosition": { "x": 180, "y": 190 }, "applicationFolderPosition": { "x": 480, "y": 190 } } }
  }
}
